# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mern-todo?retryWrites=true&w=majority

# Port for the server (Render sets this automatically)
PORT=5000

# Your deployed frontend URL (e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173
